---
// Safe design preview route. Existing homepage and backend are unchanged.
// After review, move this page's content to index.astro (not the entire file).
import JnShell from '../components/JnShell.astro';
import '../styles/jilnova-premium.css';
---
<JnShell title="جيلنوفا — قيمة بتكمل | تجربة التصميم الجديد" description="منصة مصرية لإعادة الاستخدام والتدوير؛ قيمة بتكمل من إيد لإيد.">
  <main id="main-content" class="jv2-page" dir="rtl">
    <section class="jv2-hero" aria-labelledby="jv2-title">
      <div class="jv2-orbit jv2-orbit-a" aria-hidden="true"></div><div class="jv2-orbit jv2-orbit-b" aria-hidden="true"></div>
      <div class="jv2-container jv2-hero-grid">
        <div class="jv2-hero-copy">
          <div class="jv2-overline"><span class="jv2-pulse"></span> مبادرة مصرية للاقتصاد الدائري <span class="jv2-overline-line"></span> JILNOVA</div>
          <h1 id="jv2-title">الحاجة اللي خلّصت<br/>دورها معاك،<br/><em>لسه ليها حكاية.</em></h1>
          <p>جيلنوفا بتوصل اللي عندك باللي محتاجه. مستلزمات مدرسة تتباع أو تتبدّل أو تتبرّع بيها، وورق وكرتون يوصلوا لجهة تدوير مناسبة.</p>
          <div class="jv2-hero-actions"><a href="/explore" class="jv2-btn jv2-btn-lime">اكتشف الحاجات المتاحة <span aria-hidden="true">↖</span></a><a href="/listings/new" class="jv2-btn jv2-btn-glass">عندي حاجة أضيفها <span aria-hidden="true">+</span></a></div>
          <div class="jv2-trust" aria-label="مميزات المنصة"><span><i aria-hidden="true">✓</i> تعامل واضح</span><span><i aria-hidden="true">✓</i> من غير رسوم مدفوعات داخلية</span><span><i aria-hidden="true">✓</i> أثر بعد التأكيد</span></div>
        </div>
        <div class="jv2-hero-art" aria-label="تمثيل بصري لدورة إعادة الاستخدام والتدوير">
          <div class="jv2-art-halo" aria-hidden="true"></div>
          <div class="jv2-visual-card jv2-card-school">
            <div class="jv2-card-topline"><span class="jv2-card-dot"></span> REUSE <span>01 / 02</span></div>
            <div class="jv2-shirt-visual"><svg viewBox="0 0 280 225" role="img" aria-label="رسم لزي مدرسي قابل لإعادة الاستخدام"><defs><linearGradient id="jv2-shirt" x1="0" x2="1" y1="0" y2="1"><stop stop-color="#395d4d"/><stop offset="1" stop-color="#15372f"/></linearGradient></defs><path d="M89 43 116 22h47l28 21 40 22-21 49-23-10v86H94v-86l-25 10-21-49z" fill="url(#jv2-shirt)" stroke="#0b2922" stroke-width="3"/><path d="m116 22 24 24 23-24-6 56h-32z" fill="#e5ebd9"/><path d="M122 25q15 17 36 1" fill="none" stroke="#96b6a0" stroke-width="3"/><path d="M139 50v140M95 108h92M118 87h16" stroke="#739180" stroke-width="2" opacity=".65"/><rect x="159" y="83" width="18" height="22" rx="3" fill="#c4f26a"/></svg></div>
            <div class="jv2-visual-bottom"><div><span class="jv2-mini-kicker">قيمة بتكمل</span><strong>زي مدرسي</strong></div><span class="jv2-price-pill">إعادة استخدام ↗</span></div>
          </div>
          <div class="jv2-visual-card jv2-card-recycle">
            <div class="jv2-card-topline"><span class="jv2-card-dot"></span> RECYCLE <span>02 / 02</span></div>
            <div class="jv2-box-visual"><svg viewBox="0 0 225 180" role="img" aria-label="رسم لصندوق كرتون قابل للتدوير"><path d="m35 67 74-34 78 34-75 35z" fill="#dfb889"/><path d="m35 67 77 35v65l-77-37z" fill="#ad7e50"/><path d="m112 102 75-35v64l-75 36z" fill="#c99762"/><path d="m70 51 76 35m-33 16v65" stroke="#855a38" stroke-width="3" opacity=".55"/><path d="M88 108v27m-10-9 10 9 10-9" stroke="#f5e1c5" stroke-width="4" fill="none" stroke-linecap="round" stroke-linejoin="round"/><path d="m35 67-17 24 77 35 17-24m75-35 19 25-75 36-19-26" fill="#e7c297" stroke="#ba8e5e" stroke-width="2"/></svg></div>
            <div class="jv2-visual-bottom"><div><span class="jv2-mini-kicker">من غير هدر</span><strong>ورق وكرتون</strong></div><span class="jv2-price-pill">تدوير ↗</span></div>
          </div>
          <div class="jv2-arc-label jv2-arc-label-top">كل حاجة ليها فرصة تانية <span>✦</span></div>
          <div class="jv2-arc-label jv2-arc-label-bottom"><span>↶</span> CIRCULAR BY DESIGN</div>
        </div>
      </div>
      <div class="jv2-hero-foot jv2-container"><span>من إيد لإيد. من مورد لقيمة.</span><span>اسكرول واكتشف <span aria-hidden="true">↓</span></span></div>
    </section>

    <section class="jv2-intro jv2-section" aria-labelledby="jv2-intro-title">
      <div class="jv2-container">
        <div class="jv2-section-title"><div><div class="jv2-kicker">ابدأ من هنا <span>— 01</span></div><h2 id="jv2-intro-title">المورد اللي عندك<br/><span>ممكن يكون فرصة لغيرك.</span></h2></div><p>مكان واحد بيوصل إعادة الاستخدام بإعادة التدوير، بخطوات مفهومة وقرارات واضحة من كل طرف.</p></div>
        <div class="jv2-path-grid">
          <a href="/explore" class="jv2-path jv2-path-reuse"><span class="jv2-path-index">01 / REUSE</span><span class="jv2-path-icon" aria-hidden="true"><svg viewBox="0 0 80 80" width="86" height="86" fill="none"><rect x="19" y="25" width="43" height="42" rx="5" fill="#235a4c"/><path d="M25 25V17a8 8 0 0 1 8-8h16a8 8 0 0 1 8 8v8" stroke="#235a4c" stroke-width="5"/><path d="M31 42h18M31 51h11" stroke="#c4f26a" stroke-linecap="round" stroke-width="4"/></svg></span><span class="jv2-path-content"><span class="jv2-path-tag">مستلزمات مدرسية</span><strong>مش لازم<br/>تشتري جديد.</strong><span class="jv2-path-desc">اكتشف كتب، شنط، وزي مدرسي ممكن يكملوا مع أسرة تانية.</span><span class="jv2-path-action">استكشف المنتجات <b>↖</b></span></span></a>
          <a href="/recycle" class="jv2-path jv2-path-recycling"><span class="jv2-path-index">02 / RECYCLE</span><span class="jv2-path-icon" aria-hidden="true"><svg width="85" height="85" viewBox="0 0 80 80" fill="none"><path d="M16 30 40 16l24 14v28L40 72 16 58z" fill="#c4f26a"/><path d="m16 30 24 14 24-14M40 44v28" stroke="#306040" stroke-width="3"/><path d="M30 38 43 22m-2 11 2-11-10 1" stroke="#306040" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="jv2-path-content"><span class="jv2-path-tag">ورق وكرتون</span><strong>اللي كنت هترميه،<br/>لسه له قيمة.</strong><span class="jv2-path-desc">اعرض خاماتك وشوف عروض جهات التجميع المعتمدة لما تكون متاحة.</span><span class="jv2-path-action">ابدأ التدوير <b>↖</b></span></span></a>
        </div>
      </div>
    </section>

    <section class="jv2-flow-section jv2-section" aria-labelledby="jv2-flow-title">
      <div class="jv2-container jv2-flow-wrap">
        <div class="jv2-flow-header"><div class="jv2-kicker">الرحلة بسيطة <span>— 02</span></div><h2 id="jv2-flow-title">تلات خطوات،<br/><span>وقيمة بتكمل.</span></h2><a class="jv2-text-link" href="/how-it-works">اعرف التفاصيل ↖</a></div>
        <div class="jv2-steps"><div class="jv2-step"><span class="jv2-step-n">01</span><div class="jv2-step-circle">◎</div><h3>اعرض الحاجة</h3><p>صورة ووصف وحالة ومنطقة عامة. بيانات قليلة ومفيدة.</p></div><div class="jv2-step"><span class="jv2-step-n">02</span><div class="jv2-step-circle">↗</div><h3>لاقوا بعض</h3><p>الطرف المناسب يطلب أو يقدم عرض، وصاحب الحاجة يختار.</p></div><div class="jv2-step"><span class="jv2-step-n">03</span><div class="jv2-step-circle">✓</div><h3>كمّلوا الحكاية</h3><p>بعد التسليم وتأكيد الطرفين، العملية بس هي اللي بتتحسب.</p></div></div>
      </div>
    </section>

    <section class="jv2-impact-section jv2-section" aria-labelledby="jv2-impact-title">
      <div class="jv2-container jv2-impact-wrap"><div><div class="jv2-kicker">حقيقي مش مجرد أرقام <span>— 03</span></div><h2 id="jv2-impact-title">بنحسب القيمة<br/><span>لما الرحلة تكتمل.</span></h2><p>مفيش أرقام مستخدمين أو شركاء مخترعة. كل عملية مكتملة بتتسجل بعد تأكيد الطرفين، والبيانات التجريبية منفصلة عن الأثر الحقيقي.</p><div class="jv2-hero-actions"><a class="jv2-btn jv2-btn-dark" href="/impact">اكتشف طريقة حساب الأثر ↖</a><a class="jv2-btn jv2-btn-outline-dark" href="/demo">شوف تجربة المسابقة</a></div></div><div class="jv2-impact-art"><div class="jv2-impact-logo">∞</div><div class="jv2-impact-legend"><span>إعادة استخدام</span><span>تدوير</span><span>قيمة جديدة</span></div></div></div>
    </section>
    <section class="jv2-last"><div class="jv2-container jv2-last-inner"><span class="jv2-last-spark">✳</span><div><span class="jv2-kicker">جاهز تبدأ؟</span><h2>خلّي الحاجة اللي عندك<br/>تبدأ حكاية جديدة.</h2></div><a class="jv2-btn jv2-btn-lime" href="/listings/new">ضيف أول حاجة <span>↖</span></a></div></section>
  </main>
</JnShell>
